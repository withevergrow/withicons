{
  "name": "images",
  "intent": "drifts softly like a stack of photos",
  "loop": { "preset": "float", "amount": 0.5, "duration": 3.2 },
  "hover": { "preset": "tilt", "origin": [10, 21], "amount": 0.7 },
  "alt": [ { "preset": "zoom", "origin": [10, 14.5], "amount": 0.6 }, { "preset": "pop" } ],
  "swap": [ { "to": "image", "effect": "slide-left" }, { "to": "gallery-horizontal", "effect": "slide-left" }, { "to": "image-plus", "effect": "scale" }, { "to": "images@solid", "effect": "scale" } ]
}
