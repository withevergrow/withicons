{
  "name": "images",
  "intent": "the stack rests while the picture slowly zooms in like a slideshow",
  "loop": {"preset": "pulse", "origin": [10,15], "amount": 0.25, "duration": 3.2},
  "hover": {"preset": "zoom", "origin": [9,18], "amount": 0.3, "duration": 0.7},
  "parts": {"A": {"preset": "zoom", "origin": [9,18], "amount": 0.3}},
  "deco": "float",
  "alt": [ {"preset": "tilt", "origin": [10,21], "amount": 0.7}, {"preset": "float", "amount": 0.35} ],
  "swap": [ {"to": "image", "effect": "slide-left"}, {"to": "gallery-horizontal", "effect": "slide-left"}, {"to": "image-plus", "effect": "scale"}, {"to": "images@solid", "effect": "scale"} ]
}
