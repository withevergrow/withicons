{
  "name": "barcode",
  "intent": "the bars dim and light like a scanner reading the code",
  "loop": {
    "preset": "fill",
    "duration": 2.4
  },
  "hover": {
    "preset": "zoom",
    "amount": 0.5,
    "duration": 0.6
  },
  "deco": "still",
  "alt": [
    {
      "preset": "flicker",
      "amount": 0.6
    },
    {
      "preset": "pulse",
      "amount": 0.5
    }
  ],
  "swap": [
    {
      "to": "qr-code",
      "effect": "flip"
    },
    {
      "to": "check",
      "effect": "scale"
    }
  ]
}
