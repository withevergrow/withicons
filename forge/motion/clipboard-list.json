{
  "name": "clipboard-list",
  "intent": "the list jitters like items being ticked off, nods when done",
  "loop": { "preset": "type", "amount": 0.25, "duration": 2.4 },
  "hover": { "preset": "type", "amount": 0.6, "duration": 0.7 },
  "parts": { "A": { "preset": "type", "amount": 0.45, "duration": 2.4, "delay": 0.06 } },
  "deco": "breathe",
  "alt": [{ "preset": "draw", "duration": 1.2 }, { "preset": "tilt", "origin": [12, 21.5], "amount": 0.6 }, { "preset": "pop" }],
  "swap": [{ "to": "clipboard-check", "effect": "flip" }, { "to": "list-checks", "effect": "fade" }]
}
