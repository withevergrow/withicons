{
  "name": "code",
  "intent": "brackets tick like typing while the slash blinks like a cursor",
  "loop": { "preset": "type", "amount": 0.4, "duration": 1.6 },
  "hover": { "preset": "jelly", "origin": [12, 12], "duration": 0.7 },
  "parts": { "A": { "preset": "flicker", "amount": 0.7, "duration": 3.2, "delay": 0.1 } },
  "deco": "float",
  "alt": [{ "preset": "draw" }, { "preset": "pop" }],
  "swap": [{ "to": "braces", "effect": "flip" }, { "to": "terminal", "effect": "fade" }, { "to": "file-code", "effect": "slide-up" }]
}
