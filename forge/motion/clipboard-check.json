{
  "name": "clipboard-check",
  "intent": "the check mark writes itself on, like a task just signed off",
  "loop": { "preset": "breathe", "amount": 0.5, "duration": 3.2 },
  "hover": { "preset": "draw", "duration": 0.9 },
  "alt": [
    { "preset": "nod", "origin": [12, 21.5] },
    { "preset": "pop" },
    { "preset": "tada", "amount": 0.6 }
  ],
  "swap": [
    { "to": "clipboard-list", "effect": "flip" },
    { "to": "clipboard", "effect": "fade" },
    { "to": "clipboard-check@solid", "effect": "scale" }
  ]
}
