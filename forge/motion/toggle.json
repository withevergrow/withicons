{
  "name": "toggle",
  "intent": "the knob slides across the track like a switch being flipped",
  "loop": {
    "preset": "jelly",
    "amount": 0.3,
    "duration": 2.8
  },
  "hover": {
    "preset": "jelly",
    "amount": 0.7
  },
  "parts": {
    "A": {
      "preset": "nudge",
      "dir": 180,
      "amount": 2,
      "delay": 0.05
    }
  },
  "deco": "twinkle",
  "alt": [
    {
      "preset": "pop"
    },
    {
      "preset": "pulse",
      "origin": [
        15,
        12
      ],
      "amount": 0.6
    }
  ],
  "swap": [
    {
      "to": "toggle@solid",
      "effect": "scale"
    },
    {
      "to": "sliders",
      "effect": "fade"
    }
  ]
}
