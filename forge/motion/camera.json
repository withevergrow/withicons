{
  "name": "camera",
  "intent": "the lens focuses in and out, the shutter snaps on hover",
  "loop": { "preset": "pulse", "origin": [12, 13.5], "amount": 0.25, "duration": 3.4 },
  "hover": { "preset": "pop", "origin": [12, 13.5], "amount": 0.8 },
  "parts": { "A": { "preset": "zoom", "origin": [12, 13.5], "amount": 0.5, "delay": 0.15 } },
  "alt": [{ "preset": "glow", "amount": 0.8 }, { "preset": "zoom", "origin": [12, 13.5], "amount": 0.6 }],
  "swap": [{ "to": "image", "effect": "flip" }, { "to": "video-camera", "effect": "fade" }, { "to": "check", "effect": "scale" }, { "to": "camera@solid", "effect": "scale" }]
}
