{
  "name": "receipt",
  "intent": "the lines print in on a steady slip; feeds out on hover",
  "loop": {
    "preset": "pulse",
    "origin": [
      12,
      2.5
    ],
    "amount": 0.25,
    "duration": 3
  },
  "hover": {
    "preset": "nudge",
    "dir": 90,
    "amount": 0.4,
    "duration": 0.8
  },
  "parts": {
    "A": {
      "preset": "fill",
      "duration": 3,
      "delay": 0.15
    }
  },
  "deco": "still",
  "alt": [
    {
      "preset": "draw"
    },
    {
      "preset": "float",
      "amount": 0.5
    }
  ],
  "swap": [
    {
      "to": "check",
      "effect": "scale"
    },
    {
      "to": "file-text",
      "effect": "slide-up"
    },
    {
      "to": "receipt@solid",
      "effect": "scale"
    }
  ]
}
