  "deco": "float",
  "alt": [ { "preset": "pulse", "origin": [12, 21], "amount": 0.25 }, { "preset": "jelly", "origin": [12, 21], "amount": 0.6 }, { "preset": "type", "amount": 0.5 } ],
  "swap": [ { "to": "oven@solid", "effect": "scale" }, { "to": "bread", "effect": "slide-up" }, { "to": "cooking-pot", "effect": "fade" } ]
