{
  "name": "calendar-plus",
  "intent": "the plus pops onto the page like a new event being added",
  "loop": { "preset": "pulse", "origin": [12, 13], "amount": 0.25, "duration": 2.6 },
  "hover": { "preset": "pop", "origin": [12, 15.5], "amount": 0.9 },
  "parts": { "A": { "preset": "pop", "origin": [12, 15.5], "amount": 0.6, "delay": 0.1 } },
  "alt": [{ "preset": "bounce", "amount": 0.6 }, { "preset": "jelly" }],
  "swap": [{ "to": "calendar-check", "effect": "morph" }, { "to": "calendar", "effect": "fade" }, { "to": "calendar-plus@solid", "effect": "scale" }]
}
