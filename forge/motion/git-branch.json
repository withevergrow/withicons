    "duration": 3
  },
  "hover": {
    "preset": "draw",
    "duration": 1.2
  },
  "alt": [
    {
      "preset": "pulse",
      "amount": 0.6
    },
    {
      "preset": "sway",
      "origin": [
        6.5,
        21
      ]
    }
  ],
  "swap": [
    {
      "to": "git-merge",
      "effect": "morph"
    },
    {
      "to": "git-pull-request",
      "effect": "fade"
    }
  ]
}
