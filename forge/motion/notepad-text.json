{
  "name": "notepad-text",
  "intent": "jitters softly like notes being typed out",
  "loop": { "preset": "type", "amount": 0.5, "duration": 2.4 },
  "hover": { "preset": "wiggle", "origin": [12, 4], "amount": 0.8 },
  "alt": [
    { "preset": "draw", "duration": 1.4 },
    { "preset": "float", "amount": 0.5, "duration": 3 },
    { "preset": "pop" }
  ],
  "swap": [
    { "to": "sticky-note", "effect": "flip" },
    { "to": "pencil", "effect": "rotate" },
    { "to": "notepad-text@solid", "effect": "scale" }
  ]
}
