{
  "name": "clock-check",
  "intent": "the hands tick round and the check nods: right on time",
  "loop": { "preset": "pulse", "amount": 0.25, "duration": 3.2 },
  "hover": { "preset": "nod", "amount": 0.6 },
  "parts": { "A": { "preset": "tick", "origin": [12, 12], "steps": 12, "duration": 6 }, "S": { "preset": "pop", "origin": [18, 17.5], "amount": 0.6, "duration": 3.2, "delay": 0.15 } },
  "deco": "twinkle",
  "alt": [{ "preset": "draw", "duration": 0.9 }, { "preset": "pop" }],
  "swap": [{ "to": "clock", "effect": "fade" }, { "to": "clock-alert", "effect": "morph" }, { "to": "clock-check@solid", "effect": "scale" }]
}
