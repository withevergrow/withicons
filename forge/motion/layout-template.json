{
  "name": "layout-template",
  "intent": "blocks settle into place like a page being laid out",
  "loop":  { "preset": "jelly", "amount": 0.4, "duration": 3 },
  "hover": { "preset": "jelly", "amount": 0.8, "duration": 0.7 },
  "alt":   [ { "preset": "draw" }, { "preset": "pop", "amount": 0.8 } ],
  "swap":  [ { "to": "layout-dashboard", "effect": "morph" }, { "to": "layout-grid", "effect": "fade" }, { "to": "layout-list", "effect": "slide-up" } ]
}
