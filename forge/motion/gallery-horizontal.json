{
  "name": "gallery-horizontal",
  "intent": "the slides glide left like a carousel moving to the next one",
  "loop": {
    "preset": "nudge",
    "dir": 180,
    "amount": 0.35,
    "duration": 2.8
  },
  "hover": {
    "preset": "nudge",
    "dir": 180,
    "amount": 0.7,
    "duration": 0.6
  },
  "parts": {
    "A": {
      "preset": "nudge",
      "dir": 180,
      "amount": 0.9,
      "delay": 0.1
    }
  },
  "deco": "float",
  "alt": [
    {
      "preset": "pass",
      "dir": 180,
      "amount": 0.5
    },
    {
      "preset": "flip"
    }
  ],
  "swap": [
    {
      "to": "images",
      "effect": "fade"
    },
    {
      "to": "layout-grid",
      "effect": "morph"
    },
    {
      "to": "image",
      "effect": "slide-left"
    }
  ]
}
