{
  "name": "scan-face",
  "intent": "pulses gently like a face scan in progress",
  "loop": { "preset": "pulse", "origin": [12, 12], "amount": 0.5, "duration": 2 },
  "hover": { "preset": "zoom", "origin": [12, 12], "amount": 0.6, "duration": 0.6 },
  "alt": [ { "preset": "blink", "origin": [12, 9.75] }, { "preset": "nod", "amount": 0.7 } ],
  "swap": [ { "to": "user-check", "effect": "fade" }, { "to": "shield-check", "effect": "scale" }, { "to": "smile", "effect": "blur" } ]
}
