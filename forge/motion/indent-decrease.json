{
  "name": "indent-decrease",
  "intent": "pulls the lines back out, one tab to the left",
  "loop": { "preset": "nudge", "dir": 180, "amount": 0.5, "duration": 2.6 },
  "hover": { "preset": "nudge", "dir": 180, "amount": 1.1 },
  "alt": [ { "preset": "pass", "dir": 180, "amount": 0.6 }, { "preset": "pop" } ],
  "swap": [
    { "to": "indent-increase", "effect": "slide-right" },
    { "to": "align-left", "effect": "fade" }
  ]
}
