{
  "name": "circle-arrow-left",
  "intent": "nudges left like a back button inviting a tap",
  "loop": { "preset": "nudge", "dir": 180, "amount": 0.4, "duration": 2 },
  "hover": { "preset": "nudge", "dir": 180, "amount": 0.9, "duration": 0.6 },
  "alt": [
    { "preset": "pop" },
    { "preset": "pass", "dir": 180, "duration": 0.8 }
  ],
  "swap": [
    { "to": "circle-arrow-right", "effect": "rotate" },
    { "to": "circle-arrow-left@solid", "effect": "scale" },
    { "to": "arrow-left", "effect": "fade" }
  ]
}
