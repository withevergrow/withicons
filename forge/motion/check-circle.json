{
  "name": "check-circle",
  "intent": "the tick writes itself inside a calm ring; draws on hover",
  "loop": { "preset": "pulse", "amount": 0.35, "duration": 3 },
  "hover": { "preset": "draw", "duration": 0.8 },
  "parts": { "A": { "preset": "draw", "duration": 3, "delay": 0.15 } },
  "deco": "twinkle",
  "alt": [{ "preset": "pop" }, { "preset": "nod" }],
  "swap": [{ "to": "check-circle@solid", "effect": "scale" }, { "to": "x-circle", "effect": "morph" }, { "to": "circle", "effect": "fade" }]
}
