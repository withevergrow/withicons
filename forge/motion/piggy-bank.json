{
  "name": "piggy-bank",
  "intent": "swells with savings, hops when a coin goes in",
  "loop": { "preset": "breathe", "amount": 0.5, "duration": 3.2 },
  "hover": { "preset": "bounce", "origin": [11, 21.5], "amount": 0.7 },
  "alt": [
    { "preset": "rock", "origin": [11, 21.5], "amount": 0.5 },
    { "preset": "wiggle", "origin": [11, 21.5] },
    { "preset": "jelly" }
  ],
  "swap": [
    { "to": "coins", "effect": "slide-down" },
    { "to": "wallet", "effect": "fade" },
    { "to": "piggy-bank@solid", "effect": "scale" }
  ]
}
