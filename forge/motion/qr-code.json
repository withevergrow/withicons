{
  "name": "qr-code",
  "intent": "the data modules shimmer as if being read; scans on hover",
  "loop": {
    "preset": "pulse",
    "amount": 0.25,
    "duration": 3.2
  },
  "hover": {
    "preset": "fill",
    "duration": 0.8
  },
  "parts": {
    "A": {
      "preset": "fill",
      "duration": 3.2,
      "delay": 0.15
    }
  },
  "deco": "still",
  "alt": [
    {
      "preset": "zoom",
      "amount": 0.6
    },
    {
      "preset": "glow"
    }
  ],
  "swap": [
    {
      "to": "check",
      "effect": "scale"
    },
    {
      "to": "barcode",
      "effect": "flip"
    },
    {
      "to": "qr-code@solid",
      "effect": "scale"
    }
  ]
}
