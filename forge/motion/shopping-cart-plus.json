{
  "name": "shopping-cart-plus",
  "intent": "rolls along, then pops as an item is added",
  "loop": { "preset": "nudge", "dir": 0, "amount": 0.4, "duration": 2.6 },
  "hover": { "preset": "pop", "amount": 1.1 },
  "alt": [
    { "preset": "bounce", "origin": [12, 21.5], "amount": 0.6 },
    { "preset": "jelly" },
    { "preset": "pass", "dir": 0 }
  ],
  "swap": [
    { "to": "check", "effect": "scale" },
    { "to": "shopping-cart", "effect": "fade" },
    { "to": "shopping-cart-plus@solid", "effect": "scale" }
  ]
}
