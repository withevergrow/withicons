{
  "name": "circle-dollar-sign",
  "intent": "spins like a coin now and then; flips on hover",
  "loop": { "preset": "flip", "duration": 4 },
  "hover": { "preset": "flip", "duration": 0.8 },
  "parts": { "A": { "preset": "pulse", "amount": 0.5, "duration": 4, "delay": 0.1 } },
  "deco": "twinkle",
  "alt": [{ "preset": "glow", "amount": 0.7 }, { "preset": "tada", "amount": 0.8 }, { "preset": "pop" }],
  "swap": [{ "to": "dollar-sign", "effect": "fade" }, { "to": "badge-dollar-sign", "effect": "flip" }, { "to": "circle-dollar-sign@solid", "effect": "scale" }]
}
