{
  "name": "circle-arrow-up",
  "intent": "lifts gently upward, like back to top or level up",
  "loop": { "preset": "nudge", "dir": 270, "amount": 0.4, "duration": 2 },
  "hover": { "preset": "nudge", "dir": 270, "amount": 0.9, "duration": 0.6 },
  "alt": [
    { "preset": "float" },
    { "preset": "pop" }
  ],
  "swap": [
    { "to": "circle-arrow-down", "effect": "rotate" },
    { "to": "circle-arrow-up@solid", "effect": "scale" },
    { "to": "arrow-up", "effect": "slide-up" }
  ]
}
