{
  "name": "alarm-clock",
  "intent": "rattles on its feet like an alarm going off, bells a beat behind",
  "loop": { "preset": "ring", "origin": [12, 20], "amount": 0.35, "duration": 3.2 },
  "hover": { "preset": "ring", "origin": [12, 20], "amount": 1.1 },
  "parts": { "A": { "preset": "ring", "delay": 0.03 } },
  "deco": "float",
  "alt": [{ "preset": "shake", "amount": 0.7 }, { "preset": "tick", "steps": 12, "duration": 6 }],
  "swap": [{ "to": "bell-ring", "effect": "fade" }, { "to": "check", "effect": "scale" }, { "to": "clock", "effect": "fade" }, { "to": "timer", "effect": "flip" }]
}
