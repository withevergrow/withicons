{
  "name": "cloud-download",
  "intent": "pulls data down from the cloud",
  "loop": {
    "preset": "float",
    "amount": 0.4,
    "duration": 3
  },
  "hover": {
    "preset": "nudge",
    "dir": 90,
    "amount": 0.8,
    "duration": 0.6
  },
  "alt": [
    {
      "preset": "drop",
      "amount": 0.6
    },
    {
      "preset": "bounce",
      "amount": 0.6
    }
  ],
  "swap": [
    {
      "to": "check",
      "effect": "scale"
    },
    {
      "to": "loader",
      "effect": "fade"
    },
    {
      "to": "cloud-upload",
      "effect": "slide-down"
    }
  ]
}
