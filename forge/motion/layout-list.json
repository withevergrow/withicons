    {
      "preset": "nudge",
      "dir": 90,
      "amount": 0.5
    },
    {
      "preset": "jelly",
      "amount": 0.7
    }
  ],
  "swap": [
    {
      "to": "layout-grid",
      "effect": "flip"
    },
    {
      "to": "list",
      "effect": "fade"
    },
    {
      "to": "table",
      "effect": "fade"
    }
