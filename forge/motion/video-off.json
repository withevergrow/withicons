{
  "name": "video-off",
  "intent": "dims quietly while the camera is off",
  "loop": { "preset": "breathe", "origin": [12, 12], "amount": 0.5, "duration": 3.6 },
  "hover": { "preset": "shake", "amount": 0.6 },
  "alt": [ { "preset": "pulse", "amount": 0.5 }, { "preset": "pop" } ],
  "swap": [ { "to": "video-camera", "effect": "draw" }, { "to": "eye-off", "effect": "fade" }, { "to": "microphone-off", "effect": "slide-left" } ]
}
