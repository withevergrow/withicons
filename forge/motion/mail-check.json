{
  "name": "mail-check",
  "intent": "the envelope rests while its check pops now and then: mail delivered",
  "loop": {"preset": "pulse", "origin": [12,12], "amount": 0.25, "duration": 3.2},
  "hover": {"preset": "nod", "amount": 0.6, "duration": 0.7},
  "parts": {"S": {"preset": "pop", "origin": [18,17.5], "amount": 1, "duration": 3.2, "delay": 0.1}},
  "deco": "twinkle",
  "alt": [ {"preset": "draw"}, {"preset": "pop"} ],
  "swap": [ {"to": "mail", "effect": "fade"}, {"to": "mail-open", "effect": "flip"}, {"to": "mail-check@solid", "effect": "scale"} ]
}
