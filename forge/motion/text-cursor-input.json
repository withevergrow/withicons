{
  "name": "text-cursor-input",
  "intent": "twitches like keystrokes landing in the field as you type",
  "loop": { "preset": "type", "amount": 0.6, "duration": 1.6 },
  "hover": { "preset": "type" },
  "alt": [ { "preset": "flicker", "amount": 0.6 }, { "preset": "tilt", "origin": [14.5, 20.5] } ],
  "swap": [ { "to": "type", "effect": "fade" } ]
}
