{
  "name": "plane-landing",
  "intent": "glides down onto the runway; the runway stays put, touches down on hover",
  "loop": {"preset": "nudge", "dir": 25, "amount": 0.6, "duration": 2.8},
  "hover": {"preset": "bounce", "origin": [12,19], "amount": 0.6, "duration": 0.8},
  "parts": {"A": {"preset": "pulse", "origin": [12,21.5], "amount": 0.25}},
  "deco": "float",
  "alt": [ {"preset": "drop", "amount": 0.6}, {"preset": "float"} ],
  "swap": [ {"to": "plane-takeoff", "effect": "fade"}, {"to": "plane", "effect": "slide-down"} ]
}
