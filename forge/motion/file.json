        21.5
      ],
      "amount": 0.6
    },
    {
      "preset": "flip"
    }
  ],
  "swap": [
    {
      "to": "file-plus",
      "effect": "fade"
    },
    {
      "to": "file-check",
      "effect": "scale"
    },
    {
      "to": "files",
      "effect": "slide-up"
    }
  ]
