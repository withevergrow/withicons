{
  "name": "check-square",
  "intent": "the box rests while its tick snaps in, like a checkbox just checked",
  "loop": { "preset": "pulse", "amount": 0.25, "duration": 3.2 },
  "hover": { "preset": "draw", "duration": 0.8 },
  "parts": { "A": { "preset": "pop", "origin": [10.75, 15.25], "amount": 1.2, "duration": 3.2, "delay": 0.15 } },
  "deco": "breathe",
  "alt": [{ "preset": "pop", "origin": [12, 12] }, { "preset": "jelly", "origin": [12, 21], "amount": 0.7 }],
  "swap": [{ "to": "square", "effect": "fade" }, { "to": "check-square@solid", "effect": "scale" }]
}
