{
  "name": "alarm-clock-check",
  "intent": "gives a small happy rattle and the check nods: alarm set",
  "loop": { "preset": "ring", "origin": [12, 20], "amount": 0.25, "duration": 3.6 },
  "hover": { "preset": "tada", "amount": 0.8 },
  "parts": { "S": { "preset": "pop", "origin": [12, 12.75], "amount": 0.6, "delay": 0.1 } },
  "deco": "twinkle",
  "alt": [{ "preset": "draw", "duration": 0.9 }, { "preset": "nod", "amount": 0.6 }],
  "swap": [{ "to": "alarm-clock", "effect": "fade" }, { "to": "alarm-clock-off", "effect": "flip" }, { "to": "alarm-clock-check@solid", "effect": "scale" }]
}
