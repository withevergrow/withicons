{
  "name": "clock",
  "intent": "the hands tick round a steady face in even steps, like passing time",
  "loop": { "preset": "pulse", "origin": [12, 12], "amount": 0.25, "duration": 6 },
  "hover": { "preset": "spin-once", "origin": [12, 12], "duration": 0.8 },
  "parts": { "A": { "preset": "tick", "origin": [12, 12], "duration": 6, "steps": 12 } },
  "alt": [{ "preset": "tick", "origin": [12, 12], "steps": 12, "duration": 3 }, { "preset": "pop" }],
  "swap": [{ "to": "alarm-clock", "effect": "fade" }, { "to": "timer", "effect": "scale" }, { "to": "history", "effect": "rotate" }]
}
