{
  "name": "highlighter",
  "intent": "the marker leans on its tip while the fresh ink glows on",
  "loop": {"preset": "sway", "origin": [9,15], "amount": 0.5, "duration": 2.8},
  "hover": {"preset": "pop", "origin": [10,10], "amount": 0.5, "duration": 0.5},
  "parts": {"A": {"preset": "fill", "amount": 0.8, "duration": 2.8, "delay": 0.1}},
  "deco": "twinkle",
  "alt": [ {"preset": "draw"}, {"preset": "glow"}, {"preset": "nudge", "dir": 180, "amount": 0.6} ],
  "swap": [ {"to": "eraser", "effect": "rotate"}, {"to": "pencil", "effect": "fade"}, {"to": "highlighter@solid", "effect": "scale"} ]
}
