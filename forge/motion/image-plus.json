{
  "name": "image-plus",
  "intent": "the plus badge pulses, inviting you to add a picture",
  "loop": { "preset": "float", "amount": 0.25, "duration": 3.2 },
  "hover": { "preset": "pop", "origin": [12, 12], "amount": 0.7 },
  "parts": { "A": { "preset": "float", "amount": 0.5, "duration": 3.2, "delay": 0.2 }, "S": { "preset": "pulse", "origin": [17.5, 17.5], "amount": 0.7, "duration": 1.6, "delay": 0.1 } },
  "deco": "breathe",
  "alt": [ { "preset": "rise" }, { "preset": "jelly", "origin": [12, 20] } ],
  "swap": [ { "to": "image", "effect": "scale" }, { "to": "check", "effect": "morph" } ]
}
