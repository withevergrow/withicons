{
  "name": "file-down",
  "intent": "drops gently, like a file landing on your device",
  "loop": { "preset": "drop", "amount": 0.4, "duration": 2.4 },
  "hover": { "preset": "nudge", "dir": 90, "amount": 0.9, "duration": 0.6 },
  "alt": [ { "preset": "bounce", "origin": [12, 21.5], "amount": 0.5 }, { "preset": "pass", "dir": 90, "amount": 0.6 } ],
  "swap": [ { "to": "file-check", "effect": "slide-down" }, { "to": "file-up", "effect": "flip" }, { "to": "download", "effect": "fade" } ]
}
