{
  "name": "layout-dashboard",
  "intent": "panels swell calmly, then pop like a refreshed dashboard",
  "loop": {"preset": "pulse", "origin": [12,12], "amount": 0.3, "duration": 3.4},
  "hover": {"preset": "pop", "amount": 0.8},
  "deco": "float",
  "alt": [ {"preset": "jelly", "amount": 0.7}, {"preset": "fill"} ],
  "swap": [ {"to": "layout-grid", "effect": "morph"}, {"to": "layout-list", "effect": "fade"}, {"to": "kanban", "effect": "fade"} ]
}
