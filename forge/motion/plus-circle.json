{
  "name": "plus-circle",
  "intent": "the plus pulses inside a steady ring, inviting you to add an item",
  "loop": { "preset": "pulse", "amount": 0.3, "duration": 3 },
  "hover": { "preset": "pop" },
  "parts": { "A": { "preset": "pulse", "amount": 0.7, "duration": 3, "delay": 0.12 } },
  "deco": "twinkle",
  "alt": [ { "preset": "spin-once", "duration": 0.6 }, { "preset": "pulse" } ],
  "swap": [ { "to": "minus-circle", "effect": "rotate" }, { "to": "check-circle", "effect": "morph" }, { "to": "x-circle", "effect": "rotate" }, { "to": "plus-circle@solid", "effect": "scale" } ]
}
