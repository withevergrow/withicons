{
  "name": "newspaper",
  "intent": "floats like the fresh morning paper, slides in when you point at it",
  "loop": {"preset": "float", "amount": 0.3, "duration": 3.4},
  "parts": {"A": {"preset": "float", "amount": 0.45, "duration": 3.4, "delay": 0.15}},
  "deco": "float",
  "hover": {"preset": "nudge", "dir": 0, "amount": 0.6, "duration": 0.6},
  "alt": [ {"preset": "flip", "duration": 1}, {"preset": "tilt", "origin": [12, 20], "amount": 0.6}, {"preset": "pop"} ],
