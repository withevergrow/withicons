{
  "name": "rotate-cw",
  "intent": "turns once clockwise, then rests",
  "loop": { "preset": "spin-once", "origin": [12, 12], "duration": 3.2 },
  "hover": { "preset": "spin-once", "origin": [12, 12], "duration": 0.7 },
  "alt": [
    { "preset": "spin", "origin": [12, 12], "duration": 3 },
    { "preset": "tick", "origin": [12, 12], "steps": 8 }
