{
  "name": "chart-bar-decreasing",
  "intent": "the bars shrink back toward the axis like a falling trend",
  "loop": { "preset": "fill", "duration": 2.4 },
  "hover": { "preset": "nudge", "dir": 180, "amount": 0.6, "duration": 0.6 },
  "parts": { "A": { "preset": "pulse", "origin": [3.5, 12], "amount": 0.25 } },
  "deco": "breathe",
  "alt": [{ "preset": "jelly", "origin": [3.5, 12], "amount": 0.6 }, { "preset": "pop", "origin": [3.5, 12] }],
  "swap": [{ "to": "chart-bar-increasing", "effect": "flip" }, { "to": "trending-down", "effect": "fade" }, { "to": "chart-bar-horizontal", "effect": "fade" }]
}
