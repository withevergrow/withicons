{
  "name": "cast",
  "intent": "sends signal waves out to the screen",
  "loop": { "preset": "fill", "duration": 2 },
  "hover": { "preset": "nudge", "dir": 315, "amount": 0.6 },
  "alt": [ { "preset": "pulse", "origin": [2, 20], "amount": 0.6 }, { "preset": "glow", "amount": 0.8 } ],
  "swap": [ { "to": "tv", "effect": "slide-up" }, { "to": "monitor", "effect": "fade" }, { "to": "cast@solid", "effect": "scale" } ]
}
