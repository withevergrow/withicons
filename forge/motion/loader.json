    ]
  },
  "alt": [
    {
      "preset": "spin",
      "origin": [
        12,
        12
      ]
    },
    {
      "preset": "breathe",
      "origin": [
        12,
        12
      ]
    }
  ],
  "swap": [
    {
      "to": "check",
      "effect": "morph"
    },
    {
      "to": "check-circle",
      "effect": "scale"
    },
    {
      "to": "x-circle",
      "effect": "scale"
    }
  ]
