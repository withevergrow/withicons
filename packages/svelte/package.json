{
  "name": "@withicons/svelte",
  "version": "0.1.0",
  "description": "300 icons x 7 styles as tree-shakable Svelte components (Svelte 4 and 5).",
  "license": "MIT",
  "author": {
    "name": "with icons — powered by Evergrow",
    "url": "https://withevergrow.com"
  },
  "homepage": "https://withicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withevergrow/withicons.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/withevergrow/withicons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "withicons",
    "with-icons",
    "svelte",
    "sveltekit",
    "svelte-icons",
    "svg-icons"
  ],
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./line": {
      "types": "./dist/line/index.d.ts",
      "svelte": "./dist/line/index.js",
      "default": "./dist/line/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "svelte": "./dist/solid/index.js",
      "default": "./dist/solid/index.js"
    },
    "./duo": {
      "types": "./dist/duo/index.d.ts",
