    "./sketch/icons/*.svelte": {
      "types": "./dist/sketch/icons/*.svelte.d.ts",
      "svelte": "./dist/sketch/icons/*.svelte",
      "default": "./dist/sketch/icons/*.svelte"
    },
    "./sketch/icons/*": {
      "types": "./dist/sketch/icons/*.svelte.d.ts",
      "svelte": "./dist/sketch/icons/*.svelte",
      "default": "./dist/sketch/icons/*.svelte"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "icon": [
        "./dist/icon.d.ts"
      ],
      "icons/*": [
        "./dist/line/icons/*.svelte.d.ts"
      ],
      "line": [
        "./dist/line/index.d.ts"
      ],
      "line/icons/*": [
        "./dist/line/icons/*.svelte.d.ts"
      ],
      "solid": [
        "./dist/solid/index.d.ts"
      ],
      "solid/icons/*": [
        "./dist/solid/icons/*.svelte.d.ts"
      ],
      "duo": [
        "./dist/duo/index.d.ts"
      ],
      "duo/icons/*": [
        "./dist/duo/icons/*.svelte.d.ts"
      ],
      "gloss": [
        "./dist/gloss/index.d.ts"
