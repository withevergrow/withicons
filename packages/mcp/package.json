{
  "name": "@withicons/mcp",
  "version": "0.4.0",
  "description": "MCP server for with icons: search 734 icons x 34 styles in plain English and get paste-ready SVG, React, Vue, Svelte, Angular, Solid, web-component or class code, every icon's colour palettes for the multi-colour styles, animation code (@withicons/motion), and files (SVG, PNG, PDF, PowerPoint, Lottie, animated GIF / APNG / PowerPoint for slides). stdio (npx), plus a hosted server at https://withicons.com/mcp.",
  "license": "MIT",
  "author": {
    "name": "with icons — powered by Evergrow",
    "url": "https://withevergrow.com"
  },
  "homepage": "https://withicons.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withevergrow/withicons.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/withevergrow/withicons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "withicons",
    "with-icons",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai",
    "claude",
    "cursor",
    "icon-search",
    "svg-icons",
    "animated-icons",
    "icon-animation",
    "multicolor-icons",
    "color-palettes",
    "animated-gif",
    "powerpoint",
    "line-icons",
    "solid-icons",
    "duo-icons",
    "gloss-icons",
    "engrave-icons",
    "blueprint-icons",
    "sketch-icons",
    "glass-icons",
    "kawaii-icons",
    "sticker-icons",
    "pixel-icons",
    "retro-icons",
    "luxe-icons",
    "bauhaus-icons",
    "skeuo-icons",
    "anime-icons",
    "gothic-icons",
    "pastel-icons",
    "coquette-icons",
    "plush-icons",
    "clay-icons",
    "bento-icons",
    "suite-icons",
    "dock-icons",
    "liquid-icons",
    "chrome-icons",
    "soft3d-icons",
    "brutal-icons",
    "utsav-icons",
    "rangoli-icons",
    "halloween-icons",
    "christmas-icons",
    "lunar-icons",
    "valentine-icons"
  ],
  "type": "module",
  "bin": {
    "withicons-mcp": "dist/stdio.mjs"
  },
  "main": "./dist/lib.mjs",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.mjs"
    },
    "./lib": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.mjs"
    },
    "./stdio": "./dist/stdio.mjs",
    "./data/*": "./dist/data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/lambda.mjs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/stdio.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "scripts": {
    "build": "node ../../forge/lib/emit-mcp.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "esbuild": "^0.28.2",
    "zod": "^4.6.5"
  }
}
