  },
  "bugs": {
    "url": "https://github.com/withevergrow/withicons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "withicons",
    "with-icons",
    "css",
    "css-icons",
    "icon-classes",
    "cdn",
    "glass",
    "skeuo",
    "gothic",
    "clay",
    "bento",
    "suite",
    "dock",
    "liquid",
    "chrome",
